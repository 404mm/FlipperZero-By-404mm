# Configuración de credenciales para automatización Ticketmaster-Podio
# Copia este archivo a .env y completa con tus credenciales reales

# Credenciales de Ticketmaster
TICKETMASTER_USER=tu_email@ejemplo.com
TICKETMASTER_PASS=tu_contraseña_ticketmaster

# Credenciales de Podio
PODIO_USER=tu_email@ejemplo.com
PODIO_PASS=tu_contraseña_podio

# Notas:
# - Nunca subas el archivo .env a repositorios públicos
# - Asegúrate de que .env esté en tu .gitignore
# - Usa contraseñas seguras y considera usar 2FA donde sea posible